{
  "name": "lemmaduck",
  "version": "0.5.3",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "pi-claude-bridge": "0.8.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "description": "A lab copilot for reproducible research, writing, and code.",
  "bin": {
    "duck": "duck",
    "lemmaduck": "lemmaduck"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts06068/LemmaDuck.git"
  },
  "homepage": "https://github.com/ts06068/LemmaDuck",
  "bugs": {
    "url": "https://github.com/ts06068/LemmaDuck/issues"
  },
  "files": [
    "dist/*.js",
    "config/",
    "docs/",
    "examples/providers/",
    "scripts/setup.py",
    "scripts/setup-editor.lua",
    "scripts/install_paths.py",
    "scripts/bootstrap-tools.py",
    "scripts/bootstrap-editor-tools.py",
    "scripts/install-launchers.py",
    "scripts/install-ui.py",
    "scripts/install-google.py",
    "scripts/rollback.py",
    "npm-shrinkwrap.json",
    "duck",
    "lemmaduck",
    "tools/*.py",
    "catalog/",
    "locks/",
    "assets/brand/",
    "templates/",
    "examples/first-study/",
    "examples/inquiry/",
    "examples/observational-medicine/",
    "scripts/bootstrap.sh",
    "src/",
    "tsconfig.json",
    "VALIDATION.md",
    "distro.json",
    "distros/",
    "release-manifest.json",
    "examples/observational-evaluation/",
    "scripts/evaluate-medical.mjs",
    "scripts/export-research-review.mjs",
    "examples/inquiry-evaluation/",
    "scripts/evaluate-inquiry.mjs"
  ],
  "lemmaduckDistro": "base",
  "keywords": [
    "lemmaduck",
    "distro-base",
    "research",
    "agent",
    "paseo"
  ]
}
